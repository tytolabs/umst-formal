cabal-version:   3.0

name:            umst-formal
version:         0.1.0.0
synopsis:        Categorical semantics bridge and Rust FFI for UMST thermodynamic gate
license:         MIT
copyright:      2026 Santosh Prabhu Shenbagamoorthy and Santhosh Shyamsundar
author:          Santhosh Shyamsundar, Santosh Prabhu Shenbagamoorthy
build-type:      Simple

-- Flag: enable Rust FFI bindings.
-- Default False so that `cabal build` and `cabal test` work without
-- first compiling the Rust ffi-bridge.
-- Enable with:  cabal build -f with-ffi
flag with-ffi
  description: Link against libumst_ffi (requires `cargo build --release` in ffi-bridge/)
  default:     False
  manual:      True

library
  exposed-modules:
    UMST
    UMST.Core
    UMST.Chem
    UMST.Chem.Kleisli
    UMST.Concrete
    UMST.Compat
    KleisliDIB
    SDFGate
    InfoTheory
    MeasurementCost
    LandauerExtension
    MonoidalState
    PrimeSpectralGuidance
    MeaningStateKleisli
    UMST.Urge.AdmitKleisli
    UMST.Urge.AntichainIndependent
    UMST.Urge.AppendOnly
    UMST.Urge.BackupRecovery
    UMST.Urge.CarrierProduct
    UMST.Urge.ClosedLoopWitness
    UMST.Urge.CobSocialGraph
    UMST.Urge.CollaborativeObject
    UMST.Urge.CompactionAsArrow
    UMST.Urge.CompactionComposite
    UMST.Urge.ContentAddressed
    UMST.Urge.CountedConsume
    UMST.Urge.CryptoCompose
    UMST.Urge.DropProvenance
    UMST.Urge.EntityRemote
    UMST.Urge.ExactAlgCoeffs
    UMST.Urge.ExactRatFreeEnergy
    UMST.Urge.ExcitementImport
    UMST.Urge.FabricNodes
    UMST.Urge.FastPathAdmit
    UMST.Urge.FrugalMi
    UMST.Urge.GateBeforeSync
    UMST.Urge.GeometricMemory
    UMST.Urge.GossipTick
    UMST.Urge.HilbertPersist
    UMST.Urge.HistoryFunctor
    UMST.Urge.HomologNotCopy
    UMST.Urge.InvariantWitness
    UMST.Urge.KleisliClone
    UMST.Urge.KleisliFetch
    UMST.Urge.KleisliInherit
    UMST.Urge.KleisliMerge
    UMST.Urge.KleisliPush
    UMST.Urge.KleisliRecover
    UMST.Urge.KleisliStatus
    UMST.Urge.LatencyBudget
    UMST.Urge.MergeSafe
    UMST.Urge.MetaReflexive
    UMST.Urge.NoWorkLost
    UMST.Urge.Reconcile
    UMST.Urge.OccupancyNotForge
    UMST.Urge.PadmaMembraneBacking
    UMST.Urge.OriginRefuse
    UMST.Urge.ProvenancePreserve
    UMST.Urge.ReplicaClass
    UMST.Urge.ReplicaCoalgebra
    UMST.Urge.ResidueReturn
    UMST.Urge.SdfCanonical
    UMST.Urge.SignedPropagate
    UMST.Urge.ThreeDagSeparate
    UMST.Urge.UmstTomlRemotes
    UMST.Urge.UnmeasuredMeasured
    UMST.Urge.WorktreeExclusive


  -- FFI module exposed only when Rust library is available.
  if flag(with-ffi)
    exposed-modules:
      FFI
    -- Do not use `extra-lib-dirs` here: Cabal 3.14+ rejects `../` in the
    -- package DB at register time. Link via explicit -L/-l (paths relative
    -- to this .cabal file, valid for local `cabal build`).
    ghc-options:       -L../target/release -lumst_ffi

  hs-source-dirs:   .
  build-depends:
    base         >= 4.18 && < 5,
    mtl          >= 2.3  && < 3.0,
    transformers >= 0.6  && < 0.7
  ghc-options:      -Wall -Wno-unused-imports
  default-language: Haskell2010

test-suite umst-properties
  type:             exitcode-stdio-1.0
  main-is:          Test.hs
  other-modules:    CreditGreedy, Dignity, EtaCog, MedianConvergence, OrderStatisticsBand, RhoEstimator
  hs-source-dirs:   test
  build-depends:
    base       >= 4.18 && < 5,
    QuickCheck >= 2.14 && < 2.16,
    umst-formal
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010

-- Rational arithmetic consistency with Lean @LandauerEinsteinBridge.lean@ tight bracket
-- (engineering check only; proof authority remains Lean).
test-suite landauer-einstein-sanity
  type:             exitcode-stdio-1.0
  main-is:          LandauerEinsteinSanity.hs
  hs-source-dirs:   test
  build-depends:
    base       >= 4.18 && < 5
  ghc-options:      -Wall
  default-language: Haskell2010

test-suite meaning-state-kleisli-props
  type:             exitcode-stdio-1.0
  main-is:          MeaningStateKleisliProps.hs
  hs-source-dirs:   test
  build-depends:
    base       >= 4.18 && < 5,
    QuickCheck >= 2.14 && < 2.16,
    umst-formal
  ghc-options:      -Wall
  default-language: Haskell2010

-- Optional: Haskell pure gate vs Rust C-ABI gate (requires libumst_ffi from ffi-bridge).
-- Not built when FFI flag is off (matches CI haskell-pure job).
test-suite umst-ffi-correspondence
  type:             exitcode-stdio-1.0
  main-is:          FFICorrespondence.hs
  hs-source-dirs:   test
  build-depends:
    base       >= 4.18 && < 5,
    umst-formal
  default-language: Haskell2010
  if flag(with-ffi)
    extra-lib-dirs: ../target/release
    extra-libraries: umst_ffi
    -- Pass `$ORIGIN` via GHC's linker driver (`-optl`) so Cabal does not strip a lone `$`.
    -- From the test exe dir up to `umst-formal/`, then `target/release` (no `LD_LIBRARY_PATH`).
    ghc-options:
      -Wall -threaded -rtsopts -with-rtsopts=-N
      -optl-Wl,-rpath,$ORIGIN
  if !flag(with-ffi)
    buildable: False

-- Smoke: ABI gate + QuickCheck once (requires libumst_ffi).
test-suite umst-ffi-abi-smoke
  type:             exitcode-stdio-1.0
  main-is:          test/AbiSmoke.hs
  hs-source-dirs:   test .
  build-depends:
    base       >= 4.18 && < 5,
    QuickCheck >= 2.14 && < 2.16,
    umst-formal
  default-language: Haskell2010
  if flag(with-ffi)
    extra-lib-dirs: ../target/release
    extra-libraries: umst_ffi
    ghc-options:
      -Wall -threaded -rtsopts -with-rtsopts=-N
      -optl-Wl,-rpath,$ORIGIN
  if !flag(with-ffi)
    buildable: False

-- Minimal `assertAbiCompatible` only — used by `scripts/verify-ffi-abi-mismatch.sh`.
executable umst-ffi-abi-check
  main-is:          tools/AbiCheck.hs
  hs-source-dirs:   .
  build-depends:
    base       >= 4.18 && < 5,
    umst-formal
  default-language: Haskell2010
  if flag(with-ffi)
    extra-lib-dirs: ../target/release
    extra-libraries: umst_ffi
    ghc-options:      -Wall -optl-Wl,-rpath,$ORIGIN
  if !flag(with-ffi)
    buildable: False
